# Supabase (lokaal: waarden uit `npx supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<publishable/anon key>
SUPABASE_SECRET_KEY=<secret/service_role key>

# Geheim voor de wisselende QR-codes bij ingang en kassa (lange willekeurige tekst)
NUXT_QR_SECRET=<openssl rand -base64 32>

# Publieke URL die in geprinte QR-codes komt (leeg = huidige website)
NUXT_PUBLIC_SITE_URL=
